@prefix cc: <https://seanchatmangpt.github.io/mfact-command-center/ontology#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

cc:RevOpsTurbulence a skos:Concept, sosa:ObservableProperty ;
  skos:inScheme cc:Capability ;
  skos:prefLabel "RevOps Turbulence" .
cc:RevOpsObservation a sosa:Observation ; sosa:observedProperty cc:RevOpsTurbulence .
